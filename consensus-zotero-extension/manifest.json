{
  "manifest_version": 3,
  "name": "Consensus → Zotero",
  "version": "0.1.0",
  "description": "Adiciona artigos encontrados no Consensus diretamente à sua biblioteca pessoal do Zotero.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.zotero.org/*",
    "https://api.crossref.org/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Consensus → Zotero",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://consensus.app/*",
        "https://www.consensus.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
